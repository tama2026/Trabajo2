tab_desc <- data %>%
summarise(
Edad_Promedio = mean(edad, na.rm = TRUE),
Edad_Mediana = median(edad, na.rm = TRUE),
Edad_SD = sd(edad, na.rm = TRUE),
Confianza_Promedio = mean(confianza_partidos, na.rm = TRUE),
Confianza_Mediana = median(confianza_partidos, na.rm = TRUE),
Confianza_SD = sd(confianza_partidos, na.rm = TRUE)
)
