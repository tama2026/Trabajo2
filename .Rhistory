load("input/data/ELSOC_Long.RData")
data <- elsoc_long_2016_2022 %>%
filter(ola==1) %>%
select(m01, m0_edad, c13, c14_02, c11, c07_02, c05_02)
data <- data %>%
rename(
educacion = m01,
edad = m0_edad,
interes_politico = c13,
info_politica = c14_02,
voto = c11,
participacion = c07_02,
confianza_partidos = c05_02
)
data <- data %>%
set_na(., na = c(-888, -999)) %>%
na.omit()
save(data,file="output/data.RData")
View(data)
