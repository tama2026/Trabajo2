# Asegurar variables
data <- data %>%
mutate(voto_bin = ifelse(voto == 1, 1, 0))
g1 <- data %>%
group_by(educacion_cat) %>%
summarise(prop_voto = mean(voto_bin, na.rm = TRUE),
edad = mean(edad, na.rm = TRUE))
grafico1 <- ggplot(data = g1,
mapping = aes(x = prop_voto, y = edad, label = educacion_cat)) +
geom_point() +
geom_smooth(method = "lm", colour = "black", fill = "lightblue", size = 0.5) +
labs(x = "Proporción que vota",
y = "Edad promedio",
caption = "Fuente: Elaboración propia en base a ELSOC 2016-2022") +
theme_bw()
grafico1
