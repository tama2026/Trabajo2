educacion %in% c(5,6) ~ "Técnica",
educacion %in% c(7,8,9,10) ~ "Universitaria",
TRUE ~ NA_character_
))
data$educacion_cat <- factor(data$educacion_cat,
levels = c("Básica", "Media", "Técnica", "Universitaria"))
