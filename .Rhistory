data <- elsoc_long_2016_2022 %>%
filter(ola==1) %>%
select(edad=m0_edad,educacion=m01,v02, v01, c12_01, c12_02, c12_03) %>%
filter(edad > 0) %>%            # Eliminar errores en edad
mutate(
ingresos = ifelse(v02 < 0, NA, v02), # Tratar valores negativos como NA
voto = as_factor(v01),               # Nominal: Participación
educacion = as_factor(m01)           # Ordinal: Nivel educativo
)
names(elsoc_long_2016_2022) %>% grep("v02", ., value = TRUE)
names(elsoc_long_2016_2022) %>% grep("f05", ., value = TRUE)
